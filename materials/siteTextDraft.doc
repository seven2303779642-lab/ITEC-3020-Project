\pard\cf1\f0\fs22\b0\sb0\sa160\sl253\slmult1 Main heading: Hello, I'm Songang Li.\par
\pard\cf1\f0\fs22\b0\sb0\sa160\sl253\slmult1 Subtitle: Information Technology (BA) Student\par
\pard\cf1\f0\fs22\b0\sb0\sa160\sl253\slmult1 Welcome text: I build responsive websites, interactive interfaces, software projects, and game modifications. I enjoy learning through practical work and turning ideas into useful digital products.\par
\pard\cf1\f0\fs22\b0\sb0\sa160\sl253\slmult1 Primary button: View My Projects\par
